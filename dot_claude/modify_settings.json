#!/bin/sh
# Claude Code: no "Co-Authored-By: Claude" in commits, no "Generated with Claude Code" in PRs.
# Only these keys are managed; the rest of settings.json (plugins, permissions, ...) is kept.
PATH="/opt/homebrew/bin:$PATH"
input=$(cat)
[ -n "$input" ] || input='{}'
printf '%s' "$input" | jq '.attribution = {"commit": "", "pr": ""} | .includeCoAuthoredBy = false'
